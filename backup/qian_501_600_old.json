[
  {
    "id": 501,
    "level": "上签",
    "poem": [
      "容人便是容自己",
      "记仇最累无人替",
      "莫把芥蒂藏心底",
      "一笑化解最便宜"
    ],
    "basic": "记仇消耗的是自己；能一笑带过的，别较真。",
    "yiji": "今日宜宽容释怀，忌怀恨在心。",
    "action": "原谅别人也放过自己。",
    "keywords": [
      "宽容",
      "释怀",
      "轻松"
    ]
  },
  {
    "id": 502,
    "level": "中签",
    "poem": [
      "繁华落尽见真纯",
      "洗去浮华始见珍",
      "莫逐虚名空热闹",
      "安静处自有深恩"
    ],
    "basic": "热闹散场才见谁真心；别追虚名，安静的关系最耐品。",
    "yiji": "今日宜回归本真，忌追逐虚名。",
    "action": "做回最真实的自己，一步步来。",
    "keywords": [
      "本真",
      "虚名",
      "沉淀"
    ]
  },
  {
    "id": 503,
    "level": "上上签",
    "poem": [
      "敢想敢做气如虹",
      "怯步最易落空空",
      "莫怕开头丑与拙",
      "做着做着便精通"
    ],
    "basic": "开头笨没关系；敢开头的人，已经赢过一半不敢动的人。",
    "yiji": "今日宜敢开头，忌怯于起步。",
    "action": "最难是开头，先开个头！",
    "keywords": [
      "敢为",
      "开头",
      "勇气"
    ]
  },
  {
    "id": 504,
    "level": "中签",
    "poem": [
      "计划再好也怕变",
      "留些弹性路才宽",
      "莫把日程排太满",
      "空出一格好转弯"
    ],
    "basic": "把每天排太满，一有变动就崩；留点空白，才转得开身。",
    "yiji": "今日宜留有余地，忌排满成绷。",
    "action": "日程别排满，空出一格。",
    "keywords": [
      "弹性",
      "计划",
      "从容"
    ]
  },
  {
    "id": 505,
    "level": "上签",
    "poem": [
      "真心换得真心回",
      "虚情终是风中灰",
      "莫耍小聪明待人",
      "老实最久亦最贵"
    ],
    "basic": "待人实诚最长远；小聪明一时爽，吃亏在信任断了。",
    "yiji": "今日宜以诚待人，忌虚与委蛇。",
    "action": "对人真诚别耍心眼，一步步来。",
    "keywords": [
      "真诚",
      "待人",
      "长久"
    ]
  },
  {
    "id": 506,
    "level": "中签",
    "poem": [
      "话多易泄心中事",
      "言少反显分量值",
      "莫逢人便倾倒尽",
      "分寸留些更相宜"
    ],
    "basic": "交浅言深最易吃亏；话留三分，反而更被尊重。",
    "yiji": "今日宜言语有度，忌和盘托出。",
    "action": "说话注意分寸，对自己好点。",
    "keywords": [
      "分寸",
      "言语",
      "谨言"
    ]
  },
  {
    "id": 507,
    "level": "上上签",
    "poem": [
      "助人一臂力非轻",
      "他日风回亦相迎",
      "莫算得失太精明",
      "善缘种下自生荫"
    ],
    "basic": "顺手帮人别太算计；好缘分埋下了，哪天就回来找你。",
    "yiji": "今日宜乐于助人，忌精于算计。",
    "action": "能帮就帮一把，别着急。",
    "keywords": [
      "助人",
      "善缘",
      "回馈"
    ]
  },
  {
    "id": 508,
    "level": "下签",
    "poem": [
      "闲言碎语最消磨",
      "听多了便乱心窝",
      "莫入是非长短里",
      "转头去做自家活"
    ],
    "basic": "八卦听多了心就乱；关掉耳朵，把精力放回自己事上最划算。",
    "yiji": "今日宜远离是非，忌掺和闲言。",
    "action": "别掺和别人的是非，一步步来。",
    "keywords": [
      "是非",
      "专注",
      "清净"
    ]
  },
  {
    "id": 509,
    "level": "上签",
    "poem": [
      "今日种因明日果",
      "踏实每一步都妥",
      "莫求一步登天去",
      "稳稳走来路不跛"
    ],
    "basic": "想走捷径常摔跤；一步一个脚印，反而最快到。",
    "yiji": "今日宜踏实前行，忌急于求成。",
    "action": "一步一脚印往前走，对自己好点。",
    "keywords": [
      "踏实",
      "积累",
      "稳健"
    ]
  },
  {
    "id": 510,
    "level": "上上签",
    "poem": [
      "三百过处又一程",
      "万法归处是从容",
      "莫向外求千百卦",
      "心定自有好前程"
    ],
    "basic": "签文是提醒不是答案；真能把日子过好，靠的是你自己的定力。",
    "yiji": "今日宜心定从容，忌外求无度。",
    "action": "心定了就不慌，别着急。",
    "keywords": [
      "收尾",
      "从容",
      "自定"
    ]
  },
  {
    "id": 511,
    "level": "上上签",
    "poem": [
      "约友同登青云岭",
      "山高也有并肩人",
      "莫道独行多寂寞",
      "笑声一路伴风轻"
    ],
    "basic": "一个人走得快，一群人走得远。别推掉邀约，热闹里藏着好状态。",
    "yiji": "今日宜结伴出游，忌闭门独坐。",
    "action": "约上朋友这周末出去玩。",
    "keywords": [
      "结伴",
      "出游",
      "同行"
    ]
  },
  {
    "id": 512,
    "level": "上签",
    "poem": [
      "周末且向郊外行",
      "柳岸风清鸟有声",
      "久在城中看倦了",
      "一身清爽胜浮名"
    ],
    "basic": "闷了就出去喘口气，自然最养人；身子松了，运气也跟着松。",
    "yiji": "今日宜亲近自然，忌困守屋内。",
    "action": "去公园或郊外走走。",
    "keywords": [
      "自然",
      "放松",
      "出游"
    ]
  },
  {
    "id": 513,
    "level": "中签",
    "poem": [
      "欲往山中雨满蹊",
      "行期暂缓未为迟",
      "不如先把家中静",
      "晴来再访旧松溪"
    ],
    "basic": "出门遇阻别硬扛，改期不是退步。安顿好自己，时机到了路自顺。",
    "yiji": "今日宜暂缓出行，忌冒雨强行。",
    "action": "出行计划先缓一缓再定。",
    "keywords": [
      "暂缓",
      "静心",
      "时机"
    ]
  },
  {
    "id": 514,
    "level": "上上签",
    "poem": [
      "携手高峰云海间",
      "半山虽喘也开颜",
      "相扶一步一风景",
      "顶上风光共此闲"
    ],
    "basic": "陪你爬到半山还笑得出的人，值得深交。关系在共同费力时炼成。",
    "yiji": "今日宜结伴登高，忌单打独斗。",
    "action": "约朋友周末去爬山登高。",
    "keywords": [
      "结伴",
      "登高",
      "情谊"
    ]
  },
  {
    "id": 515,
    "level": "上签",
    "poem": [
      "东风先染柳梢青",
      "约得二三踏野行",
      "莫道闲步无益处",
      "身心俱润胜调羹"
    ],
    "basic": "走走路说说话，比坐着想东想西强；身子动起来，心里的结也松了。",
    "yiji": "今日宜踏青散步，忌久滞不动。",
    "action": "下午出门到公园走一走。",
    "keywords": [
      "踏青",
      "散步",
      "舒展"
    ]
  },
  {
    "id": 516,
    "level": "中签",
    "poem": [
      "远途虽好费盘缠",
      "近处风光亦足怜",
      "何必名山方快意",
      "门前小径可参禅"
    ],
    "basic": "不是非得跑远才叫旅行；家附近走走，也能把日子过出新鲜感。",
    "yiji": "今日宜就近散心，忌好高骛远。",
    "action": "下班在附近逛一圈再回家。",
    "keywords": [
      "就近",
      "散心",
      "知足"
    ]
  },
  {
    "id": 517,
    "level": "上签",
    "poem": [
      "十指握拳力倍添",
      "各执一桨力更轻",
      "莫把功劳归自己",
      "众人拾柴火自明"
    ],
    "basic": "事成了别抢功；肯记着别人好的人，下次还有人愿意搭把手。",
    "yiji": "今日宜协力互助，忌独揽其功。",
    "action": "今天主动帮同事搭把手。",
    "keywords": [
      "协作",
      "互助",
      "共赢"
    ]
  },
  {
    "id": 518,
    "level": "上上签",
    "poem": [
      "呼朋唤友聚一堂",
      "火锅热气话短长",
      "平日各自奔忙惯",
      "今宵且把真心彰"
    ],
    "basic": "热闹的饭局最能卸防备。主动组一场，你就是连起大家的人。",
    "yiji": "今日宜主动组局，忌各自疏离。",
    "action": "今晚在群里攒个饭局。",
    "keywords": [
      "组局",
      "相聚",
      "热络"
    ]
  },
  {
    "id": 519,
    "level": "上签",
    "poem": [
      "乳燕双双掠水飞",
      "新巢初就羽犹微",
      "莫忧展翅风涛恶",
      "雏羽成时自夺威"
    ],
    "basic": "别拿别人的熟练比你的开头。肯带你的人，看中你这股新鲜劲。",
    "yiji": "今日宜带新人入伙，忌嘲笑生疏。",
    "action": "主动带一下新来的同事。",
    "keywords": [
      "新手",
      "成长",
      "带新"
    ]
  },
  {
    "id": 520,
    "level": "上上签",
    "poem": [
      "良朋恰在转角逢",
      "一拍即合意气同",
      "共做一桩有趣事",
      "胜他独对暮山红"
    ],
    "basic": "遇到合拍的人别犹豫，一起做点什么；共同的目标最能拉近两颗心。",
    "yiji": "今日宜携手共事，忌错失同频。",
    "action": "拉上搭档一起把这事推进。",
    "keywords": [
      "同频",
      "共事",
      "合拍"
    ]
  },
  {
    "id": 521,
    "level": "上签",
    "poem": [
      "合伙经营利均分",
      "账目公开心不昏",
      "莫因小利伤了义",
      "长久方见真金存"
    ],
    "basic": "一起做点小买卖，账要摊在明处；明算账的搭档才走得远。",
    "yiji": "今日宜公开透明，忌含糊算账。",
    "action": "该说清楚的事别藏着。",
    "keywords": [
      "合伙",
      "透明",
      "信任"
    ]
  },
  {
    "id": 522,
    "level": "中签",
    "poem": [
      "外力虽好不可凭",
      "终须自家立脚跟",
      "借得一阵风便过",
      "风停还靠腿下行"
    ],
    "basic": "借势能帮你起步，但别依赖成习惯；真本事得长在自己身上。",
    "yiji": "今日宜借力亦练功，忌只靠外援。",
    "action": "借别人的力也别忘了练自己。",
    "keywords": [
      "借力",
      "自强",
      "务实"
    ]
  },
  {
    "id": 523,
    "level": "上上签",
    "poem": [
      "贵人恰在身边立",
      "抬手便渡眼前津",
      "莫向外寻千里远",
      "回头一笑是故人"
    ],
    "basic": "常以为帮手在远方，其实肯拉你一把的就在身旁；珍惜眼前人。",
    "yiji": "今日宜亲近身边人，忌舍近求远。",
    "action": "今晚陪家人好好吃顿饭。",
    "keywords": [
      "贵人",
      "亲近",
      "惜缘"
    ]
  },
  {
    "id": 524,
    "level": "上签",
    "poem": [
      "三人同行必有师",
      "各展所长互补之",
      "莫逞能耐独挑担",
      "分工方成巧匠事"
    ],
    "basic": "别什么都自己扛；把合适的事交给合适的人，事儿反而成得快。",
    "yiji": "今日宜知人善任，忌独揽包办。",
    "action": "把这件事交给最合适的人做。",
    "keywords": [
      "分工",
      "互补",
      "团队"
    ]
  },
  {
    "id": 525,
    "level": "中签",
    "poem": [
      "合伙莫忘先立约",
      "口说无凭纸上一",
      "莫因情面含糊过",
      "清清楚楚少纠葛"
    ],
    "basic": "交情归交情，正事要有明白约定；先说清，以后才不伤和气。",
    "yiji": "今日宜白纸黑字，忌碍面含糊。",
    "action": "谈好的事今天落成文字。",
    "keywords": [
      "约定",
      "边界",
      "清晰"
    ]
  },
  {
    "id": 526,
    "level": "上签",
    "poem": [
      "顺风扬帆不用篙",
      "顺势而为境界高",
      "莫逆潮流硬去顶",
      "顺水推船自逍遥"
    ],
    "basic": "看准势头就顺着走；硬顶着干最耗神，借势的人最省力。",
    "yiji": "今日宜顺水行船，忌逆流硬顶。",
    "action": "顺着势头走，别硬来。",
    "keywords": [
      "顺势",
      "借势",
      "省力"
    ]
  },
  {
    "id": 527,
    "level": "中签",
    "poem": [
      "独处并非是孤冷",
      "静里方知己性情",
      "莫怕无人来相伴",
      "灯下读书亦有情"
    ],
    "basic": "一个人待着不是可怜；安静下来，才听得见自己真正想要什么。",
    "yiji": "今日宜独处自省，忌怕静求闹。",
    "action": "今晚留 20 分钟自己静静。",
    "keywords": [
      "独处",
      "自省",
      "安静"
    ]
  },
  {
    "id": 528,
    "level": "上签",
    "poem": [
      "夜深人静好梳头",
      "理罢烦丝便无愁",
      "莫让杂念缠梦里",
      "明朝又是新风流"
    ],
    "basic": "睡前把杂事理一理，别带进梦里；脑子清爽，第二天才轻。",
    "yiji": "今日宜睡前梳理，忌胡思乱想。",
    "action": "睡前把明天的事捋一遍。",
    "keywords": [
      "梳理",
      "安眠",
      "清爽"
    ]
  },
  {
    "id": 529,
    "level": "中签",
    "poem": [
      "久坐伤身气也淤",
      "起身舒展筋骨舒",
      "莫恋软椅不肯动",
      "活动开来病自除"
    ],
    "basic": "坐久了就起来扭扭；身子是革命本钱，懒着不动最亏自己。",
    "yiji": "今日宜起身活动，忌久坐不动。",
    "action": "坐一小时就起来动一动。",
    "keywords": [
      "活动",
      "舒展",
      "健康"
    ]
  },
  {
    "id": 530,
    "level": "上签",
    "poem": [
      "琴棋书画养性情",
      "一技傍身路不惊",
      "莫言闲艺无他用",
      "关键时刻显英明"
    ],
    "basic": "有个小爱好很加分；既能独处不慌，也能和同好聊出彩。",
    "yiji": "今日宜修习一技，忌虚度闲时。",
    "action": "花 30 分钟练一项技能。",
    "keywords": [
      "爱好",
      "技艺",
      "加分"
    ]
  },
  {
    "id": 531,
    "level": "上签",
    "poem": [
      "早起迎得第一光",
      "神清气爽一天长",
      "莫贪夜半无用乐",
      "晨风最能洗愁肠"
    ],
    "basic": "早起半天都是赚的；迎着晨光动一动，整天的底子都好了。",
    "yiji": "今日宜早起迎光，忌熬夜贪欢。",
    "action": "明早定个早点的闹钟。",
    "keywords": [
      "早起",
      "清新",
      "规律"
    ]
  },
  {
    "id": 532,
    "level": "中签",
    "poem": [
      "独行山路莫惊慌",
      "脚下自有路度量",
      "莫盼有人来引路",
      "自个儿也能到岗"
    ],
    "basic": "没人带也别慌；自己踩出来的路，记得最牢也最踏实。",
    "yiji": "今日宜独立前行，忌依赖引路。",
    "action": "这件事先试着自己搞定。",
    "keywords": [
      "独立",
      "自主",
      "踏实"
    ]
  },
  {
    "id": 533,
    "level": "上签",
    "poem": [
      "忙里偷闲泡壶茶",
      "看云卷去又生霞",
      "莫言偷懒是误事",
      "张弛有度方为佳"
    ],
    "basic": "歇口气不是偷懒；弦绷太紧易断，松一松才弹得响。",
    "yiji": "今日宜忙里偷闲，忌紧绷不休。",
    "action": "下午抽 15 分钟放松一下。",
    "keywords": [
      "张弛",
      "闲适",
      "平衡"
    ]
  },
  {
    "id": 534,
    "level": "上签",
    "poem": [
      "新朋相识一杯酒",
      "谈笑之间意气投",
      "莫拒生人于千里",
      "天下谁生即吾俦"
    ],
    "basic": "别把生人挡在门外；这一面之缘，说不定就是往后常聚的人。",
    "yiji": "今日宜接纳新识，忌拒人千里。",
    "action": "主动跟新认识的人打个招呼。",
    "keywords": [
      "新识",
      "接纳",
      "缘分"
    ]
  },
  {
    "id": 535,
    "level": "中签",
    "poem": [
      "广结善缘福自来",
      "雪中送炭记心怀",
      "莫做锦上添花客",
      "急时方知谁可哀"
    ],
    "basic": "平时多真心待人，别只挑热闹时凑；难时谁帮你是平时攒的。",
    "yiji": "今日宜真心待人，忌趋炎附势。",
    "action": "今天对人少点套路多点真心。",
    "keywords": [
      "善缘",
      "真心",
      "积累"
    ]
  },
  {
    "id": 536,
    "level": "上签",
    "poem": [
      "兴趣相投觅同好",
      "聊得投机忘了老",
      "莫笑爱好太细碎",
      "同频最是难得找"
    ],
    "basic": "按兴趣去找同好，聊得来的人，最解孤单。",
    "yiji": "今日宜按趣寻伴，忌闭门索居。",
    "action": "去找跟你同好的人聊聊。",
    "keywords": [
      "同好",
      "兴趣",
      "同频"
    ]
  },
  {
    "id": 537,
    "level": "上签",
    "poem": [
      "同好相邀习一艺",
      "切磋琢磨日精进",
      "莫妒旁人来得早",
      "各自花期各样明"
    ],
    "basic": "跟同好一起练本事，别比快慢；各人节奏不同，进步就好。",
    "yiji": "今日宜同好共修，忌攀比焦躁。",
    "action": "约同好一起玩你们都爱的。",
    "keywords": [
      "共修",
      "切磋",
      "精进"
    ]
  },
  {
    "id": 538,
    "level": "中签",
    "poem": [
      "泛泛之交百千个",
      "危难之际剩几个",
      "莫把时间耗尽在",
      "点头之交的应和"
    ],
    "basic": "面上客气的人再多，不如两三个能说真心话的；精力留给值得的。",
    "yiji": "今日宜精简社交，忌广而不深。",
    "action": "推掉一个没意义的饭局。",
    "keywords": [
      "精简",
      "深交",
      "值得"
    ]
  },
  {
    "id": 539,
    "level": "上签",
    "poem": [
      "主场之邀显心意",
      "做回东道聚人气",
      "莫总做客不肯请",
      "你来我往后路密"
    ],
    "basic": "别总当客人；偶尔做东，关系才热络起来。",
    "yiji": "今日宜主动做东，忌只做客不请。",
    "action": "今晚你请客，把朋友约出来。",
    "keywords": [
      "做东",
      "互动",
      "人气"
    ]
  },
  {
    "id": 540,
    "level": "中签",
    "poem": [
      "言语投机休尽吐",
      "三分保留七分度",
      "莫因聊得投了缘",
      "私密全交陌生路"
    ],
    "basic": "聊得再投缘也留三分；生人面前，私密别一股脑倒。",
    "yiji": "今日宜留分寸感，忌尽吐私密。",
    "action": "聊天别问太私人的问题。",
    "keywords": [
      "分寸",
      "保留",
      "谨慎"
    ]
  },
  {
    "id": 541,
    "level": "上签",
    "poem": [
      "旧友久疏一线牵",
      "约顿饭局话从前",
      "莫让忙成了借口",
      "老交情最值千金"
    ],
    "basic": "老朋友别因忙就断了；一顿饭的功夫，情谊就续上了。",
    "yiji": "今日宜联络旧友，忌任其疏远。",
    "action": "给老朋友发条消息叙叙旧。",
    "keywords": [
      "旧友",
      "联络",
      "情谊"
    ]
  },
  {
    "id": 542,
    "level": "上上签",
    "poem": [
      "月老悄然系一丝",
      "转角遇见恰逢时",
      "莫道孤单无尽头",
      "那人正在灯火迟"
    ],
    "basic": "缘分常在你不注意时来；别丧，对的人可能就在下个转角。",
    "yiji": "今日宜敞开心扉，忌自我封闭。",
    "action": "把心里的话跟信任的人说说。",
    "keywords": [
      "缘分",
      "遇见",
      "敞开心"
    ]
  },
  {
    "id": 543,
    "level": "上签",
    "poem": [
      "春水初生鸭自闲",
      "情动于心莫迟疑",
      "莫把心意藏太死",
      "错过花期悔已迟"
    ],
    "basic": "心里动了就别闷着；合适的时候表达，比憋成遗憾强。",
    "yiji": "今日宜坦然表达，忌错失心意。",
    "action": "把心里的想法直接说出来。",
    "keywords": [
      "表达",
      "心意",
      "坦然"
    ]
  },
  {
    "id": 544,
    "level": "中签",
    "poem": [
      "乍见欢喜须冷静",
      "朝夕相处方见性",
      "莫凭一眼定终身",
      "久看才知合与拧"
    ],
    "basic": "一见钟情先别上头；朝夕处下来，脾性合不合才见真章。",
    "yiji": "今日宜冷静相处，忌一时上头。",
    "action": "有分歧先冷一冷再谈。",
    "keywords": [
      "冷静",
      "相处",
      "观察"
    ]
  },
  {
    "id": 545,
    "level": "中签",
    "poem": [
      "旧伤未愈休急赴",
      "先把自己疗一疗",
      "莫带残痕入新局",
      "干净才好接新朝"
    ],
    "basic": "上一段没理顺，先安顿好自己；带着旧伤进场，对谁都不公。",
    "yiji": "今日宜先疗旧伤，忌仓促赴新。",
    "action": "那件伤心事先让自己缓一缓。",
    "keywords": [
      "疗愈",
      "干净",
      "自重"
    ]
  },
  {
    "id": 546,
    "level": "上上签",
    "poem": [
      "良缘恰似茶初泡",
      "回甘慢慢才落到",
      "莫求轰烈三刻热",
      "细长日子最牢靠"
    ],
    "basic": "好的感情像好茶，回甘在后面；别只图开头热闹。",
    "yiji": "今日宜细水长流，忌图一时烈。",
    "action": "给在意的人发条消息问候。",
    "keywords": [
      "细水",
      "长久",
      "回甘"
    ]
  },
  {
    "id": 547,
    "level": "上签",
    "poem": [
      "风急浪高舟自摇",
      "四面乌云压顶来",
      "咬紧牙关撑过去",
      "云开日出见春台"
    ],
    "basic": "最难的那一阵最考验定力，撑住不松手，翻过这浪头就是好天。",
    "yiji": "今日宜咬牙撑过，忌临阵退缩。",
    "action": "再坚持一下就过去了！",
    "keywords": [
      "上签"
    ]
  },
  {
    "id": 548,
    "level": "上签",
    "poem": [
      "异地虽远心相近",
      "每日一语胜千金",
      "莫让距离成了墙",
      "诚意最能渡山林"
    ],
    "basic": "远一点没关系，天天有回音就暖；诚意够，距离只是数字。",
    "yiji": "今日宜常系一线，忌疏于联络。",
    "action": "给老朋友发条消息保持联系。",
    "keywords": [
      "异地",
      "诚意",
      "联络"
    ]
  },
  {
    "id": 549,
    "level": "下签",
    "poem": [
      "连日奔忙神已疲",
      "强撑只会损身躯",
      "莫把硬扛当本事",
      "歇口气再上山梯"
    ],
    "basic": "累到极限还硬撑最伤；歇一歇不是怂，是给自己续命。",
    "yiji": "今日宜休养回血，忌硬撑透支。",
    "action": "今晚好好休息别熬夜。",
    "keywords": [
      "休养",
      "回血",
      "惜身"
    ]
  },
  {
    "id": 550,
    "level": "下签",
    "poem": [
      "旧事缠身理还乱",
      "抽刀断水水更漫",
      "莫在泥里反复搅",
      "隔开一段自清安"
    ],
    "basic": "旧事越搅越乱；隔一段距离，反而自己清了。",
    "yiji": "今日宜抽离隔断，忌反复纠缠。",
    "action": "离让你烦的事远一点。",
    "keywords": [
      "抽离",
      "隔断",
      "清安"
    ]
  },
  {
    "id": 551,
    "level": "中签",
    "poem": [
      "莫赔笑脸去迎人",
      "累了先歇自己身",
      "人生万般都要紧",
      "先把己心安放稳"
    ],
    "basic": "别总赔着笑脸讨好别人；累了就歇，先把自己安顿好，才顾得上别的。",
    "yiji": "今日宜先歇一歇，忌硬撑迎人。",
    "action": "先停下来歇口气再干。",
    "keywords": [
      "自歇",
      "安放",
      "不撑"
    ]
  },
  {
    "id": 552,
    "level": "下签",
    "poem": [
      "流言入耳且随风",
      "何必句句放心胸",
      "莫与闲人论长短",
      "自顾前行路自通"
    ],
    "basic": "闲话听进去了就乱；不接茬，走自己的路最清净。",
    "yiji": "今日宜充耳不闻，忌卷入是非。",
    "action": "闲言碎语今天别往耳朵里进。",
    "keywords": [
      "流言",
      "不闻",
      "自顾"
    ]
  },
  {
    "id": 553,
    "level": "中签",
    "poem": [
      "病来如山未可轻",
      "且停琐事把息宁",
      "莫言小恙无须管",
      "养好方能再行程"
    ],
    "basic": "身子亮红灯就别硬上；小病拖大，后面更耽误。",
    "yiji": "今日宜停手养病，忌带病硬撑。",
    "action": "不舒服就停下来休息。",
    "keywords": [
      "养病",
      "停手",
      "重视"
    ]
  },
  {
    "id": 554,
    "level": "中签",
    "poem": [
      "借出钱财难收回",
      "情义常被数字摧",
      "莫因心软频相借",
      "护好自身方不亏"
    ],
    "basic": "钱借出去常难回；心软归心软，自己的底先护住。",
    "yiji": "今日宜谨慎借出，忌因软破财。",
    "action": "借钱借物今天先缓缓。",
    "keywords": [
      "谨慎",
      "护财",
      "边界"
    ]
  },
  {
    "id": 555,
    "level": "下签",
    "poem": [
      "强求一物不得休",
      "越追越远惹烦忧",
      "莫把执念系太死",
      "松手新景自可游"
    ],
    "basic": "越是死追越留不住，松手反而一身轻；执念太死，新风景都错过了。",
    "yiji": "今日宜松手放下，忌死缠苦求。",
    "action": "那件攥着的事今天松手。",
    "keywords": [
      "放下",
      "松手",
      "释然"
    ]
  },
  {
    "id": 556,
    "level": "上签",
    "poem": [
      "险峰虽峻亦可攀",
      "志定何惧路弯弯",
      "莫因畏难收了步",
      "登顶方知天地宽"
    ],
    "basic": "看着难的事，定了心就上；登顶那刻，之前的怕都值了。",
    "yiji": "今日宜迎难而上，忌临阵退缩。",
    "action": "挑最难的那件事先做 10 分钟。",
    "keywords": [
      "迎难",
      "立志",
      "登顶"
    ]
  },
  {
    "id": 557,
    "level": "上上签",
    "poem": [
      "试玉要烧三日满",
      "辨人须待事上观",
      "莫凭初面下定论",
      "久处才知谁可担"
    ],
    "basic": "想看清一个人，放事上试；初印象最会骗人。",
    "yiji": "今日宜事上识人，忌以貌取人。",
    "action": "跟人合作件小事看他靠不靠谱。",
    "keywords": [
      "识人",
      "试玉",
      "久观"
    ]
  },
  {
    "id": 558,
    "level": "中签",
    "poem": [
      "初战受挫莫灰心",
      "败局之中藏妙音",
      "莫把一失当终局",
      "复盘方知路哪深"
    ],
    "basic": "头回没成别丧；败里藏着经验，复盘完下一步就准了。",
    "yiji": "今日宜复盘总结，忌一败即馁。",
    "action": "把今天做错的地方记上一笔。",
    "keywords": [
      "复盘",
      "总结",
      "不馁"
    ]
  },
  {
    "id": 559,
    "level": "上签",
    "poem": [
      "新题虽生手生疏",
      "练过三遍便自如",
      "莫怕开头笨拙态",
      "熟了自能绘宏图"
    ],
    "basic": "没做过别怕起步丑；练三遍就熟，谁也不是天生会。",
    "yiji": "今日宜勤练上手，忌怕拙止步。",
    "action": "今天把新学的东西上手练一次。",
    "keywords": [
      "勤练",
      "上手",
      "不怕拙"
    ]
  },
  {
    "id": 560,
    "level": "上签",
    "poem": [
      "担子压肩脊更直",
      "越是重活越惜力",
      "莫言负荷无可奈",
      "扛过方知自个强"
    ],
    "basic": "担子重别怨；扛过去才知道自己比想的能扛。",
    "yiji": "今日宜担责历练，忌推诿避事。",
    "action": "主动揽一件有责任的活。",
    "keywords": [
      "担责",
      "历练",
      "自强"
    ]
  },
  {
    "id": 561,
    "level": "中签",
    "poem": [
      "欲速反迟古有训",
      "慢工方能出细锦",
      "莫赶进度丢了质",
      "稳扎才不返工辛"
    ],
    "basic": "赶太快常返工；慢一点把事儿做透，反倒最省。",
    "yiji": "今日宜稳扎稳打，忌贪快返工。",
    "action": "今天宁可慢点也别返工。",
    "keywords": [
      "稳扎",
      "慢工",
      "保质"
    ]
  },
  {
    "id": 562,
    "level": "上签",
    "poem": [
      "试错本是有用功",
      "每跌一跤路更通",
      "莫怕出乖露了丑",
      "摔过才知哪是坑"
    ],
    "basic": "出丑别怕；每摔一次，就少一个将来的坑。",
    "yiji": "今日宜不怕试错，忌因羞止步。",
    "action": "大胆试一次，错了再说。",
    "keywords": [
      "试错",
      "不怕丑",
      "成长"
    ]
  },
  {
    "id": 563,
    "level": "中签",
    "poem": [
      "执念太深反成障",
      "放手一程天地广",
      "莫把旧事怀里捂",
      "风过自然心舒畅"
    ],
    "basic": "抓太紧反成枷锁；松一松，风一过心里就透亮了。",
    "yiji": "今日宜学着放手，忌抱残守缺。",
    "action": "这件你抓太紧的事放一放。",
    "keywords": [
      "放手",
      "豁达",
      "舒畅"
    ]
  },
  {
    "id": 564,
    "level": "上签",
    "poem": [
      "缘分尽了莫强留",
      "好聚好散两无仇",
      "莫把离去当失败",
      "各奔前程也是修"
    ],
    "basic": "人走了别硬拽；体面作别，各自往前也是修行。",
    "yiji": "今日宜体面告别，忌强留纠缠。",
    "action": "好好跟过去告个别。",
    "keywords": [
      "告别",
      "体面",
      "不缠"
    ]
  },
  {
    "id": 565,
    "level": "中签",
    "poem": [
      "旧情如茶凉透底",
      "再温已是别般味",
      "莫反复热求如初",
      "放下杯盏换新醴"
    ],
    "basic": "凉了的情再热也变味；放下旧杯，才能接新的一盏。",
    "yiji": "今日宜翻篇换新，忌反复回温。",
    "action": "把旧的一页翻过去。",
    "keywords": [
      "翻篇",
      "换新",
      "不恋"
    ]
  },
  {
    "id": 566,
    "level": "中签",
    "poem": [
      "争论赢了理却输",
      "关系裂了最难补",
      "莫因口舌争高下",
      "退一步海阔天初"
    ],
    "basic": "争赢了道理输了人，不值；退一步，关系还在。",
    "yiji": "今日宜退让求和，忌争口舌赢。",
    "action": "这场争执让一步海阔天空。",
    "keywords": [
      "退让",
      "求和",
      "关系"
    ]
  },
  {
    "id": 567,
    "level": "中签",
    "poem": [
      "他人眼光如风过",
      "何必字字放心窝",
      "莫为闲评改了路",
      "自个儿舒坦最妥"
    ],
    "basic": "旁人怎么看，风一样吹过；别为几句闲话，改了自己要走的方向。",
    "yiji": "今日宜不在意评，忌为他人活。",
    "action": "别人怎么说别往心里去。",
    "keywords": [
      "不在意",
      "自我",
      "舒坦"
    ]
  },
  {
    "id": 568,
    "level": "上签",
    "poem": [
      "聚散本是无常事",
      "来时欢喜去无滞",
      "莫将离别看得重",
      "江湖再遇有相期"
    ],
    "basic": "聚散寻常；来欢喜去不滞，江湖那么大，还会再见。",
    "yiji": "今日宜看淡聚散，忌伤离执别。",
    "action": "人来人往别太执着。",
    "keywords": [
      "聚散",
      "看淡",
      "再会"
    ]
  },
  {
    "id": 569,
    "level": "中签",
    "poem": [
      "旧怨宜解不宜结",
      "结久成疾蚀心血",
      "莫记前嫌不肯放",
      "一笑便能过界缺"
    ],
    "basic": "旧怨别结成疙瘩；记久了伤的是自己，一笑就过了。",
    "yiji": "今日宜化解旧怨，忌积怨成疾。",
    "action": "主动缓和跟那人的关系。",
    "keywords": [
      "化解",
      "一笑",
      "不积"
    ]
  },
  {
    "id": 570,
    "level": "上签",
    "poem": [
      "缘来缘去皆有因",
      "惜取当下这一段",
      "莫愁明朝各西东",
      "今宵共饮莫辞斟"
    ],
    "basic": "缘起缘灭都有因；惜好眼前这一段，比愁以后强。",
    "yiji": "今日宜惜取当下，忌预支离愁。",
    "action": "把眼前这一刻过好。",
    "keywords": [
      "当下",
      "惜缘",
      "共饮"
    ]
  },
  {
    "id": 571,
    "level": "上上签",
    "poem": [
      "小本经营亦生财",
      "诚字当头客自来",
      "莫嫌起步微利薄",
      "滚雪方成大山陪"
    ],
    "basic": "小本买卖也生财；诚字最招客，雪球滚起就大了。",
    "yiji": "今日宜诚信经营，忌嫌小不为。",
    "action": "答应客户的事今天兑现。",
    "keywords": [
      "经营",
      "诚信",
      "积累"
    ]
  },
  {
    "id": 572,
    "level": "中签",
    "poem": [
      "饭后徐行百步轻",
      "晚风拂面步从容",
      "莫道闲走无益处",
      "心宽体健胜药功"
    ],
    "basic": "饭后走一走，比什么补品都实在；身子松了，心也跟着松。",
    "yiji": "今日宜饭后散步，忌久坐不动。",
    "action": "晚饭后下楼走 20 分钟。",
    "keywords": [
      "散步",
      "松快",
      "养身"
    ]
  },
  {
    "id": 573,
    "level": "上签",
    "poem": [
      "记账一本心有数",
      "进出分明不糊涂",
      "莫嫌琐碎懒得理",
      "年终方知富与枯"
    ],
    "basic": "记记账，进出有数；懒得理，年底才知钱去哪了。",
    "yiji": "今日宜理清账目，忌糊涂度日。",
    "action": "今晚把这几天的账单对一遍。",
    "keywords": [
      "记账",
      "理清",
      "有数"
    ]
  },
  {
    "id": 574,
    "level": "中签",
    "poem": [
      "消费之前三思量",
      "需与想要两样腔",
      "莫被一时兴起买",
      "回家闲置占地方"
    ],
    "basic": "下单前分分清需要和想要；头脑一热买回，多半吃灰。",
    "yiji": "今日宜理性消费，忌冲动入手。",
    "action": "买东西前想想真需要吗。",
    "keywords": [
      "理性",
      "消费",
      "克制"
    ]
  },
  {
    "id": 575,
    "level": "上签",
    "poem": [
      "技能加身价自高",
      "闲时学艺不辞劳",
      "莫言此刻用不上",
      "他日换路靠这招"
    ],
    "basic": "多一门手艺多一条路；闲时学的，换道时就是底气。",
    "yiji": "今日宜投资自己，忌荒废本领。",
    "action": "在自己身上花点钱或时间。",
    "keywords": [
      "学艺",
      "加身",
      "底气"
    ]
  },
  {
    "id": 576,
    "level": "上签",
    "poem": [
      "攒钱如积水中沙",
      "日添一粒自成洼",
      "莫笑零星不足道",
      "久积方见满缸华"
    ],
    "basic": "攒钱像积沙，一天一粒也成洼；别笑零钱少，久了就满。",
    "yiji": "今日宜坚持储蓄，忌轻视零积。",
    "action": "今天往存钱罐放一笔。",
    "keywords": [
      "储蓄",
      "积少",
      "坚持"
    ]
  },
  {
    "id": 577,
    "level": "上签",
    "poem": [
      "借债需有还的计",
      "莫为面子举债急",
      "量力而行是正理",
      "窟窿补上才安逸"
    ],
    "basic": "借钱得有归还的打算；撑场面借的钱最沉，填平了才睡得安稳。",
    "yiji": "今日宜量力举债，忌为面举债。",
    "action": "借钱的事量力而行别硬撑。",
    "keywords": [
      "举债",
      "量力",
      "补窟"
    ]
  },
  {
    "id": 578,
    "level": "上签",
    "poem": [
      "子时安眠养精神",
      "亥初熄灯梦自真",
      "莫让流光偷了夜",
      "清眠胜似贴金身"
    ],
    "basic": "早睡最养人；别让光亮的方框偷了你的夜，好眠抵万金。",
    "yiji": "今日宜早睡养神，忌熬到夜深。",
    "action": "今晚 11 点前上床睡觉。",
    "keywords": [
      "早睡",
      "养神",
      "规律"
    ]
  },
  {
    "id": 579,
    "level": "中签",
    "poem": [
      "久坐伤腰气血淤",
      "每小时起展身躯",
      "莫恋椅中不肯动",
      "舒展方知体不虚"
    ],
    "basic": "坐一小时就起来展展；淤久了浑身不舒服，舒展才通透。",
    "yiji": "今日宜定时起身，忌久坐淤堵。",
    "action": "每小时起来活动 5 分钟。",
    "keywords": [
      "起身",
      "舒展",
      "通体"
    ]
  },
  {
    "id": 580,
    "level": "上签",
    "poem": [
      "三餐有序胃乃安",
      "莫教饥饱两极端",
      "粗茶淡饭养人久",
      "胜过珍馐肠胃翻"
    ],
    "basic": "三餐定时最养胃。平常饭菜吃久身子受用，胜过偶尔大餐闹肚子。",
    "yiji": "今日宜三餐定时，忌饥饱无度。",
    "action": "今天三顿饭按时吃。",
    "keywords": [
      "三餐",
      "养胃",
      "规律"
    ]
  },
  {
    "id": 581,
    "level": "中签",
    "poem": [
      "心火太旺眠不安",
      "睡前宜把气来宽",
      "莫把日间不平事",
      "带进罗帷梦里盘"
    ],
    "basic": "白天的不平别带进被窝；心里火气太盛，觉也睡不沉。",
    "yiji": "今日宜睡前宽心，忌带气入眠。",
    "action": "睡前别想烦心事，好好睡觉。",
    "keywords": [
      "宽心",
      "安眠",
      "去火"
    ]
  },
  {
    "id": 582,
    "level": "上签",
    "poem": [
      "清晨吐纳吸纳新",
      "慢跑几圈气血匀",
      "莫嫌运动一时苦",
      "换来整日精神振"
    ],
    "basic": "早起动一动，气血就匀；一时的累，换一整天精神。",
    "yiji": "今日宜晨间运动，忌懒卧不起。",
    "action": "明早起来活动 15 分钟。",
    "keywords": [
      "运动",
      "吐纳",
      "精神"
    ]
  },
  {
    "id": 583,
    "level": "中签",
    "poem": [
      "用眼过度目生花",
      "每看一时远山斜",
      "莫盯近物不肯歇",
      "极目方舒眼底霞"
    ],
    "basic": "看近久了望远处歇歇；不歇，眼里就花了。",
    "yiji": "今日宜远眺护眼，忌久盯近物。",
    "action": "看手机久了抬头看看远处。",
    "keywords": [
      "护眼",
      "远眺",
      "舒缓"
    ]
  },
  {
    "id": 584,
    "level": "上签",
    "poem": [
      "粗衣淡饭亦安然",
      "心足何须羡大千",
      "莫把浮名肩上扛",
      "轻装最好过平川"
    ],
    "basic": "知足不是不上进，是不让贪念牵着走；轻装的人走得远。",
    "yiji": "今日宜惜已有，忌贪更多。",
    "action": "数数你已经拥有的东西。",
    "keywords": [
      "知足",
      "轻装",
      "安然"
    ]
  },
  {
    "id": 585,
    "level": "中签",
    "poem": [
      "饮酒过量最伤身",
      "微醺即可莫沉醉",
      "莫借浇愁频举盏",
      "清醒方能把事推"
    ],
    "basic": "酒微醺就好；借酒浇愁最伤，清醒才扛得住事。",
    "yiji": "今日宜饮酒有度，忌贪杯浇愁。",
    "action": "酒到微醺就停，留三分清醒。",
    "keywords": [
      "饮酒",
      "有度",
      "清醒"
    ]
  },
  {
    "id": 586,
    "level": "上签",
    "poem": [
      "季节更替添衣先",
      "莫逞硬朗受风寒",
      "莫言小病无大碍",
      "护好身子路才宽"
    ],
    "basic": "换季先添衣；别逞硬朗，小病拖大就误事。",
    "yiji": "今日宜添衣防寒，忌逞强受冻。",
    "action": "出门多带件外套别着凉。",
    "keywords": [
      "添衣",
      "防寒",
      "护身"
    ]
  },
  {
    "id": 587,
    "level": "上签",
    "poem": [
      "常笑之人运自嘉",
      "眉间不锁福来加",
      "莫把脸绷如铁板",
      "松颜最能引人洽"
    ],
    "basic": "常笑的人运气不差；脸别绷着，松弛才招人近。",
    "yiji": "今日宜常驻笑颜，忌眉头紧锁。",
    "action": "今天见人先笑一下。",
    "keywords": [
      "常笑",
      "松弛",
      "招福"
    ]
  },
  {
    "id": 588,
    "level": "上上签",
    "poem": [
      "胸有丘壑气自闲",
      "宠辱不惊看云还",
      "莫教外物摇心志",
      "稳坐中军阵不乱"
    ],
    "basic": "心里有底就稳；外物再晃，也别让它摇了你的阵脚。",
    "yiji": "今日宜宠辱不惊，忌随物喜悲。",
    "action": "今天好事坏事都稳住心态。",
    "keywords": [
      "豁达",
      "稳心",
      "不惊"
    ]
  },
  {
    "id": 589,
    "level": "上签",
    "poem": [
      "烦恼皆因想太多",
      "少思少虑睡如舵",
      "莫把未至的事儿",
      "提前愁坏自个窝"
    ],
    "basic": "多半烦恼是想出来的；没发生的事，别提前替自己愁。",
    "yiji": "今日宜少思少虑，忌预支烦恼。",
    "action": "别瞎想，想了也没用。",
    "keywords": [
      "少虑",
      "放下",
      "轻松"
    ]
  },
  {
    "id": 590,
    "level": "上签",
    "poem": [
      "感恩之心常点亮",
      "小事也知谢身旁",
      "莫把拥有当应当",
      "惜福方能源流长"
    ],
    "basic": "常感恩，小处也谢；把本有的当成理所当然，福就漏了。",
    "yiji": "今日宜常怀感恩，忌视为应当。",
    "action": "想想今天值得感谢的事。",
    "keywords": [
      "感恩",
      "惜福",
      "源头"
    ]
  },
  {
    "id": 591,
    "level": "中签",
    "poem": [
      "完美本是虚中影",
      "苛求反累自家命",
      "莫因小瑕弃全玉",
      "大体无亏便算幸"
    ],
    "basic": "完美是虚的；因小瑕疵丢整块玉，最亏。大体好就庆幸。",
    "yiji": "今日宜接纳瑕疵，忌苛求完美。",
    "action": "别对自己太苛刻，接受不完美。",
    "keywords": [
      "不苛",
      "接纳",
      "大体"
    ]
  },
  {
    "id": 592,
    "level": "上上签",
    "poem": [
      "吃亏未必是真亏",
      "暗里积来好口碑",
      "莫争毫厘伤了义",
      "长远方知谁不亏"
    ],
    "basic": "吃点亏不一定是亏；义字积下了，长远看谁都不亏。",
    "yiji": "今日宜肯吃点亏，忌毫厘必争。",
    "action": "小事吃点亏别计较。",
    "keywords": [
      "吃亏",
      "积义",
      "长远"
    ]
  },
  {
    "id": 593,
    "level": "上签",
    "poem": [
      "言语如刀须慎用",
      "一句暖人一句冷",
      "莫凭快意伤人腑",
      "出口之前三思省"
    ],
    "basic": "话像刀，出口前想三秒；图一时痛快扎了人，事后最难补。",
    "yiji": "今日宜慎言暖语，忌快语伤人。",
    "action": "说话前先过一遍脑子。",
    "keywords": [
      "慎言",
      "暖语",
      "三思"
    ]
  },
  {
    "id": 594,
    "level": "上上签",
    "poem": [
      "万物皆有裂痕在",
      "裂痕原是光来脉",
      "莫因残缺嫌弃己",
      "破处生辉更奇哉"
    ],
    "basic": "残缺处恰是光进来的地方；别嫌自己不完美，裂痕也生辉。",
    "yiji": "今日宜接纳残缺，忌自嫌不足。",
    "action": "不完美的也接受它。",
    "keywords": [
      "接纳",
      "裂痕",
      "生辉"
    ]
  },
  {
    "id": 595,
    "level": "上签",
    "poem": [
      "行善不为名与利",
      "暗处栽花亦有意",
      "莫期回报方去施",
      "无心之善最珍稀"
    ],
    "basic": "行善别图回报；不期而施的那点好，最珍贵。",
    "yiji": "今日宜无心行善，忌图报而施。",
    "action": "顺手做件不图回报的好事。",
    "keywords": [
      "行善",
      "无求",
      "珍贵"
    ]
  },
  {
    "id": 596,
    "level": "中签",
    "poem": [
      "边界不清最累心",
      "谁来都允失了准",
      "莫做老好无底线",
      "适度拒绝方安身"
    ],
    "basic": "边界模糊最累；老好人不说no，最后累的是自己。该拒就拒才安。",
    "yiji": "今日宜学会拒绝，忌无底纵容。",
    "action": "今天拒掉一个你不想答应的请求。",
    "keywords": [
      "边界",
      "拒绝",
      "自安"
    ]
  },
  {
    "id": 597,
    "level": "上签",
    "poem": [
      "倾听胜似千言教",
      "先听后说方入窍",
      "莫抢话头不肯住",
      "懂人方能处得好"
    ],
    "basic": "多听少抢最讨喜；老抢话头的人，最难处好关系。",
    "yiji": "今日宜先听后说，忌打断别人说话。",
    "action": "今天先听别人讲完再开口。",
    "keywords": [
      "倾听",
      "懂人",
      "相处"
    ]
  },
  {
    "id": 598,
    "level": "上签",
    "poem": [
      "新知如海无止境",
      "每日拾得一颗星",
      "莫言已足不再学",
      "活水方能润性灵"
    ],
    "basic": "新知学不完；每天拾一颗星，人就不僵。",
    "yiji": "今日宜持续学习，忌自满停学。",
    "action": "今天学点新东西，哪怕一点。",
    "keywords": [
      "学习",
      "新知",
      "活水"
    ]
  },
  {
    "id": 599,
    "level": "上签",
    "poem": [
      "遇挫翻书寻答案",
      "前人智慧解迷乱",
      "莫耻下问蒙了羞",
      "肯学之人路不短"
    ],
    "basic": "卡了就翻书问人；肯学的人，路永远长。",
    "yiji": "今日宜勤学善问，忌耻于下问。",
    "action": "不懂的今天就开口问。",
    "keywords": [
      "勤学",
      "下问",
      "解迷"
    ]
  },
  {
    "id": 600,
    "level": "上上签",
    "poem": [
      "岁月从不负深耕",
      "默默栽树终成荫",
      "莫羡旁人一时艳",
      "你的果在后来林"
    ],
    "basic": "岁月不负踏实的人；别人一时风光别眼热，好收成在后头林里。",
    "yiji": "今日宜默默深耕，忌羡人一时。",
    "action": "继续默默打磨你的事。",
    "keywords": [
      "深耕",
      "沉淀",
      "后来"
    ]
  }
]