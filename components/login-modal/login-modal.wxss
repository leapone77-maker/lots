.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.dialog {
  width: 82%;
  padding: 56rpx 44rpx 48rpx;
  background: linear-gradient(180deg, #2a1d14 0%, #241710 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5), 0 0 40rpx rgba(212, 175, 55, 0.06);
  position: relative;
}

/* 关闭按钮 */
.dlg-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255,255,255,0.3);
  border-radius: 50%;
}
.dlg-close:active {
  background: rgba(255,255,255,0.08);
}

/* 标题区 */
.dlg-title {
  font-size: 42rpx;
  color: #d4af37;
  font-weight: bold;
  text-align: center;
  letter-spacing: 2rpx;
}
.dlg-sub {
  font-size: 24rpx;
  color: #9a8c7a;
  text-align: center;
  margin: 16rpx 0 0;
  line-height: 1.5;
}

/* 提示小字 —— 融入副标题下方，用淡金色细线分隔，像注释说明 */
.dlg-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 20rpx 0 0;
  font-size: 22rpx;
  color: rgba(212, 175, 55, 0.5);
}
.dlg-hint::before,
.dlg-hint::after {
  content: '';
  display: inline-block;
  width: 32rpx;
  height: 1rpx;
  background: rgba(212, 175, 55, 0.25);
}

/* 输入框 */
.ipt {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 16rpx;
  color: #f3e9d8;
  padding: 26rpx 28rpx;
  margin-top: 28rpx;
  font-size: 30rpx;
  transition: all 0.2s ease;
}
.ipt:focus {
  border-color: rgba(212, 175, 55, 0.5);
  background: rgba(255, 255, 255, 0.09);
  box-shadow: 0 0 0 4rpx rgba(212, 175, 55, 0.08);
}

/* 登录按钮 */
.dlg-btn {
  width: 100%;
  padding: 24rpx;
  margin-top: 36rpx;
  background: linear-gradient(135deg, #e8c547 0%, #d4af37 100%);
  color: #241710;
  font-size: 32rpx;
  border-radius: 16rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(212, 175, 55, 0.25);
}
.dlg-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

/* 错误提示 */
.err {
  color: #e0795b;
  font-size: 26rpx;
  text-align: center;
  margin-top: 20rpx;
}
