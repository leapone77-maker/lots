page {
  background: #F5F0E6;
  min-height: 100vh;
}

.page {
  /* border-box：padding 计入 100vh 内，内容不超屏时整页不可滚动 */
  box-sizing: border-box;
  min-height: 100vh;
  padding: 20rpx 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  /* 暖调米杏底 + 祥云暗纹 */
  background:
    url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20width='90'%20height='90'%20viewBox='0%200%2090%2090'>%0A<g%20fill='%23C9A961'%20fill-opacity='0.06'>%0A<path%20d='M22%2058c0-9%207-15%2015-14%203-9%2015-9%2018-1%208-3%2015%205%2012%2012-3%208-13%207-18%204-4%206-15%205-19-1-5%203-12-1-14-6z'/>%0A<path%20d='M52%2030c0-6%205-10%2011-9%202-6%2011-6%2013%200%206-2%2011%204%209%209-2%206-10%205-14%203-3%204-11%203-14-1-3%202-8-1-10-5z'/>%0A</g>%0A</svg>")
    repeat,
    linear-gradient(180deg, #FCF8F0 0%, #F5F0E6 45%, #EFE7D6 100%);
}

/* ===== 统计卡片 ===== */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 253, 248, 0.85);
  border: 1rpx solid rgba(201, 169, 97, 0.22);
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 85, 50, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.stat-good { color: #A8201A; }
.stat-mid { color: #B8860B; }
.stat-low { color: #5a7a5a; }

.stat-label {
  font-size: 23rpx;
  color: rgba(80, 60, 40, 0.55);
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(201, 169, 97, 0.25);
}

/* ===== 日历卡片 ===== */
.calendar-card {
  background: rgba(255, 253, 248, 0.85);
  border: 1rpx solid rgba(201, 169, 97, 0.22);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 85, 50, 0.06);
}

.cal-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 18rpx;
}

/* 清空：日历卡片右上角 */
.cal-clear {
  position: absolute;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 25rpx;
  color: #c0392b;
  padding: 8rpx 4rpx;
}

.cal-arrow {
  font-size: 36rpx;
  color: #A8201A;
  padding: 8rpx 12rpx;
  font-weight: bold;
}

.cal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  min-width: 220rpx;
  text-align: center;
}

.cal-weekdays {
  display: flex;
  margin-bottom: 10rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: rgba(80, 60, 40, 0.45);
  padding: 8rpx 0;
}

.cal-days {
  display: flex;
  flex-wrap: wrap;
}

.cal-day {
  width: calc(100% / 7);
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 14rpx;
  margin: 2rpx 0;
}

.day-num {
  font-size: 27rpx;
  color: #333;
}

.other-month .day-num {
  color: rgba(180, 160, 140, 0.35);
}

/* 选中日期：红圈（唯一的圆圈标记，同一时刻只有一个） */
.cal-day.selected .day-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #A8201A;
  border-radius: 50%;
  color: #A8201A;
  font-weight: bold;
  font-size: 26rpx;
}

.cal-day.has-record .day-num {
  color: #A8201A;
  font-weight: bold;
}

/* 今天：橙色数字（圆圈专属选中态，今天不带圈）；置于 has-record 后保证优先 */
.cal-day.today .day-num {
  color: #F59E0B;
  font-weight: bold;
}

/* 今天同时被选中：红圈内橙色数字 */
.cal-day.today.selected .day-num {
  color: #F59E0B;
}

.day-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #A8201A;
  margin-top: 2rpx;
}

/* ===== 记录列表 ===== */
.records-section {
  background: rgba(255, 253, 248, 0.75);
  border: 1rpx solid rgba(201, 169, 97, 0.18);
  border-radius: 20rpx;
  overflow: hidden;
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(201, 169, 97, 0.15);
}

.records-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #A8201A;
  background: #A8201A;
  color: #fff;
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
}

.records-list {
  padding: 0 8rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid rgba(168, 32, 26, 0.06);
  gap: 14rpx;
}

.record-badge {
  padding: 6rpx 14rpx;
  background: #A8201A;
  color: #fff;
  font-size: 21rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.record-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-level-tag {
  font-size: 21rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.level-shang { background: rgba(168, 32, 26, 0.1); color: #A8201A; }
.level-zhong { background: rgba(184, 134, 11, 0.1); color: #B8860B; }
.level-xia { background: rgba(90, 122, 90, 0.1); color: #5a7a5a; }

.record-time {
  font-size: 22rpx;
  color: rgba(160, 140, 110, 0.55);
}

.record-arrow {
  font-size: 32rpx;
  color: rgba(160, 140, 110, 0.35);
  flex-shrink: 0;
}

.records-empty {
  padding: 48rpx 24rpx;
  text-align: center;
}

.records-empty text {
  font-size: 27rpx;
  color: rgba(160, 140, 110, 0.45);
}
