page {
  background: #F5F0E6;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
  /* 暖调米杏底 + 祥云暗纹 */
  background:
    url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20width='90'%20height='90'%20viewBox='0%200%2090%2090'>%0A<g%20fill='%23C9A961'%20fill-opacity='0.06'>%0A<path%20d='M22%2058c0-9%207-15%2015-14%203-9%2015-9%2018-1%208-3%2015%205%2012%2012-3%208-13%207-18%204-4%206-15%205-19-1-5%203-12-1-14-6z'/>%0A<path%20d='M52%2030c0-6%205-10%2011-9%202-6%2011-6%2013%200%206-2%2011%204%209%209-2%206-10%205-14%203-3%204-11%203-14-1-3%202-8-1-10-5z'/>%0A</g>%0A</svg>")
    repeat,
    linear-gradient(180deg, #FCF8F0 0%, #F5F0E6 45%, #EFE7D6 100%);
}

/* ===== 签诗卡片 ===== */
.qian-card {
  margin: 8rpx 24rpx 16rpx;
  padding: 28rpx 28rpx 24rpx;
  background: rgba(255, 253, 248, 0.85);
  border: 1rpx solid rgba(201, 169, 97, 0.22);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(120, 85, 50, 0.08);
}

.qian-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  position: relative;
}

.qian-header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.qian-badge {
  padding: 6rpx 18rpx;
  background: #A8201A;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
}

.qian-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

/* 右上角分享图标：绝对定位用普通 view 包裹，绕开 button 默认 width:100% 干扰 */
.qian-share-wrap {
  position: absolute;
  right: -4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qian-share-btn {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.qian-share-btn::after {
  border: none;
}

.qian-share-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.85;
}

.qian-poem-section {
  margin-bottom: 16rpx;
}

.poem-label {
  display: block;
  font-size: 24rpx;
  color: #A8201A;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.poem-text {
  display: block;
  font-size: 29rpx;
  color: #333;
  line-height: 1.75;
  letter-spacing: 1rpx;
}

.card-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201,169,97,0.3), transparent);
  margin: 16rpx 0;
}

.interpret-section {
  margin-bottom: 12rpx;
}

.interp-label {
  display: block;
  font-size: 24rpx;
  color: #A8201A;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.interp-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.interp-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.interp-tag {
  font-size: 25rpx;
  color: #A8201A;
  font-weight: bold;
}

.interp-val {
  font-size: 27rpx;
  color: #333;
  line-height: 1.65;
}

.card-tip {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(201,169,97,0.2);
}

.card-tip text {
  font-size: 26rpx;
  color: #A8201A;
}

/* ===== 整体可滚动区域（签诗+解答+聊天 一起滚）===== */
.main-scroll {
  flex: 1;
  height: 0;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  padding: 12rpx 24rpx 0;
}

.message {
  display: flex;
  margin-bottom: 18rpx;
  max-width: 88%;
}

.message.user {
  align-self: flex-end;
  flex-direction: row-reverse;
  margin-right: 4rpx;
}

.message.assistant {
  align-self: flex-start;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(168,32,26,0.08);
  border: 1rpx solid rgba(168,32,26,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0 12rpx;
  overflow: hidden;
}

.avatar-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.message-avatar text {
  font-size: 24rpx;
  color: #A8201A;
}

.message-bubble {
  background: rgba(255,255,255,0.72);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  word-break: break-all;
  max-width: 480rpx;
  box-shadow: 0 2rpx 10rpx rgba(120,90,50,0.06);
}

.message.user .message-bubble {
  background: rgba(201,169,97,0.28);
  border: 1rpx solid rgba(201,169,97,0.25);
}

.message.user .message-bubble rich-text {
  color: #4a3728;
}

/* ===== "思考中"气泡动画 ===== */
.thinking-bubble {
  display: inline-block;
  padding: 8rpx 0;
}

.thinking-dots {
  color: #999;
  font-size: 18px;
  letter-spacing: 4rpx;
  animation: thinkingPulse 1.2s ease-in-out infinite;
}

@keyframes thinkingPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* ===== 底部输入栏 ===== */
.input-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 14rpx 16rpx;
  /* 与首页底部文字一致：贴近底部黑线 */
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(245,240,230,0.92);
  border-top: 1rpx solid rgba(201,169,97,0.20);
  position: relative;
  z-index: 50;
}

.quota-tip {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: rgba(168,32,26,0.72);
  padding-bottom: 10rpx;
  letter-spacing: 1rpx;
}

/* 分享引导行（基础次数用完、未领奖励时显示） */
.quota-guide {
  display: block;
  font-size: 24rpx;
  color: rgba(168,32,26,0.72);
  line-height: 1.6;
}

.quota-share-btn {
  display: inline-block;
  margin: 8rpx auto 0;
  padding: 6rpx 28rpx;
  background: #A8201A;
  color: #fff;
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 999rpx;
  border: none;
}

.quota-share-btn::after {
  border: none;
}

/* ===== 展开的大输入框面板 ===== */
.expand-panel {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 70rpx;
  background: rgba(245,240,230,0.98);
  border-top: 1rpx solid rgba(201,169,97,0.25);
  padding: 0 16rpx;
  z-index: 60;
}

.expand-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 8rpx;
}

.expand-textarea {
  width: 100%;
  min-height: 320rpx;
  max-height: 500rpx;
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(201,169,97,0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.expand-textarea::placeholder {
  color: rgba(80,60,40,0.45);
  font-size: 30rpx;
}

/* ===== 单行输入栏 ===== */
.input-row {
  display: flex;
  align-items: center;
  width: 100%;
}

.expand-icon {
  width: 68rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.expand-icon-svg {
  width: 44rpx;
  height: 44rpx;
  background: #ffffff;
  border: 1rpx solid rgba(80,70,55,0.15);
  border-radius: 14rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

.expand-collapse {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.expand-collapse .expand-icon-svg {
  width: 40rpx;
  height: 40rpx;
  background: #ffffff;
  border: 1rpx solid rgba(80,70,55,0.15);
  border-radius: 12rpx;
  padding: 10rpx;
}

.input-field {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.6);
  border: 1rpx solid rgba(201,169,97,0.25);
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #333333;
  margin-right: 16rpx;
}

.input-field::placeholder {
  color: rgba(80,60,40,0.45);
  font-size: 30rpx;
}

.send-btn {
  min-width: 148rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(168,32,26,0.12);
  flex-shrink: 0;
}

.send-btn.active {
  background: #A8201A;
}

.send-btn text {
  font-size: 28rpx;
  color: #A8201A;
  white-space: nowrap;
}

.send-btn.active text {
  color: #ffffff;
  font-weight: bold;
}

/* ===== 屏幕中间 toast ===== */
.center-toast-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  pointer-events: none;
  transform: translateY(-200rpx);
}

.center-toast-box {
  background: rgba(0, 0, 0, 0.82);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 48rpx;
  max-width: 70vw;
  font-size: 30rpx;
  text-align: center;
  line-height: 1.5;
  white-space: nowrap;
}
