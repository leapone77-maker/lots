<view class="page">
  <!-- 整体可滚动区域：签诗 + 解答 + 聊天 全部一起滚 -->
  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollToId}}">

    <!-- 签诗卡片（自动展示） -->
    <view class="qian-card" wx:if="{{qian}}" bindlongpress="onLongPressQian">
      <!-- 签号 + 等级 + 分享 -->
      <view class="qian-header">
        <view class="qian-header-left">
          <view class="qian-badge">{{qian.level}}</view>
          <text class="qian-title">第 {{qian.id}} 签 · {{qian.level}}</text>
        </view>
        <!-- 分享按钮：用普通 view 做绝对定位容器，避免 button 默认 width:100% 干扰 -->
        <view class="qian-share-wrap" wx:if="{{hasDrawn && !localMode}}">
          <button wx:if="{{isLoggedIn}}" class="qian-share-btn" open-type="share" bindtap="onShareTap">
            <image class="qian-share-icon" src="/images/share-icon.png" mode="aspectFit"/>
          </button>
          <button wx:else class="qian-share-btn" bindtap="onShareTap">
            <image class="qian-share-icon" src="/images/share-icon.png" mode="aspectFit"/>
          </button>
        </view>
      </view>

      <!-- 签诗 -->
      <view class="qian-poem-section">
        <text class="poem-label">【签诗】</text>
        <text class="poem-text">{{qian.poemText}}</text>
      </view>

      <!-- 分隔线 -->
      <view class="card-divider"></view>

      <!-- 基础解答（自动展示） -->
      <view class="interpret-section" wx:if="{{qian.basic}}">
        <text class="interp-label">【解签】</text>
        <text class="basic-text">{{qian.basic}}</text>
      </view>

      <!-- 分隔线 -->
      <view class="card-divider"></view>

      <!-- 宜忌（自动展示） -->
      <view class="yiji-section" wx:if="{{qian.yiji}}">
        <text class="yiji-label">【宜忌】</text>
        <text class="yiji-text">{{qian.yiji}}</text>
      </view>

      <view class="card-tip" wx:if="{{!localMode && !isLoggedIn}}">
        <text>💬 登录账号，可以得到更详细、更个性化的解读！</text>
      </view>
    </view>

    <!-- 聊天消息列表 -->
    <view class="chat-messages">
      <view class="message {{item.role}}" wx:for="{{chatMessages}}" wx:key="id" id="msg-{{item.id}}">
        <view class="message-avatar">
          <image wx:if="{{item.role === 'assistant'}}" class="avatar-logo" src="/images/jieqian-icon-peng.png" mode="aspectFit"/>
          <text wx:elif="{{item.role === 'user'}}">我</text>
        </view>
        <view class="message-bubble" catchlongpress="onLongPressMsg" data-rawtext="{{item.rawText}}">
          <rich-text nodes="{{item.content}}"></rich-text>
        </view>
      </view>
    </view>

    <!-- 底部留白（避免被输入栏遮挡最后一条消息） -->
    <view style="height:160rpx;"></view>
  </scroll-view>

  <!-- 底部固定输入栏（localMode=false 时显示） -->
  <view class="input-bar" wx:if="{{!localMode}}">
    <view class="quota-tip" wx:if="{{remainCount !== null}}">
      <text wx:if="{{remainCount > 0}}">今日还可咨询 {{remainCount}} 次</text>
      <block wx:elif="{{bonusEligible}}">
        <text class="quota-guide">分享签运结果给朋友，可再获得 1 次咨询</text>
        <button class="quota-share-btn" open-type="share" bindtap="onShareTap">去分享</button>
      </block>
      <text wx:else>今日咨询次数已用完，明天再来找阿鹏 🙏</text>
    </view>

    <!-- 展开的大输入框面板（浮在输入栏上方） -->
    <view class="expand-panel" wx:if="{{inputExpanded}}">
      <view class="expand-toolbar">
        <view class="expand-collapse" bindtap="onCollapse">
          <image class="expand-icon-svg" src="/images/icon-shouqi.png" mode="aspectFit"/>
        </view>
        <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">
          <text>发送</text>
        </view>
      </view>
      <textarea class="expand-textarea"
                maxlength="300"
                placeholder="{{hasDrawn ? '请输入您想咨询的具体问题' : '先抽一签，再向阿鹏请教...'}}"
                value="{{inputValue}}"
                bindinput="onInput"
                show-confirm-bar="{{false}}"/>
    </view>

    <!-- 底部单行输入栏（展开时隐藏） -->
    <view class="input-row" wx:if="{{!inputExpanded}}">
      <view class="expand-icon" wx:if="{{!inputExpanded}}" bindtap="onExpand">
        <image class="expand-icon-svg" src="/images/icon-zhankai.png" mode="aspectFit"/>
      </view>
      <input class="input-field"
             maxlength="300"
             placeholder="{{hasDrawn ? '请输入您想咨询的具体问题' : '先抽一签，再向阿鹏请教...'}}"
             value="{{inputValue}}"
             bindinput="onInput"
             confirm-type="send"
             bindconfirm="sendMessage"
             adjust-position="{{true}}"/>
      <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">
        <text>发送</text>
      </view>
    </view>
  </view>

  <!-- 登录弹窗 -->
  <login-modal visible="{{showLogin}}" bind:close="onCloseLogin" bind:login="onLogin"/>

  <!-- 屏幕中间 toast 提示（分享成功等） -->
  <view class="center-toast-mask" wx:if="{{centerToast.rendered}}" style="{{centerToast.boxStyle}}">
    <view class="center-toast-box">{{centerToast.text}}</view>
  </view>
</view>
