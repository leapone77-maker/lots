page {
  background: #F5F0E6;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
  /* 暖调米杏底 + 竖向微弱渐变 + 祥云暗纹 */
  background:
    url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20width='90'%20height='90'%20viewBox='0%200%2090%2090'>%0A<g%20fill='%23C9A961'%20fill-opacity='0.06'>%0A<path%20d='M22%2058c0-9%207-15%2015-14%203-9%2015-9%2018-1%208-3%2015%205%2012%2012-3%208-13%207-18%204-4%206-15%205-19-1-5%203-12-1-14-6z'/>%0A<path%20d='M52%2030c0-6%205-10%2011-9%202-6%2011-6%2013%200%206-2%2011%204%209%209-2%206-10%205-14%203-3%204-11%203-14-1-3%202-8-1-10-5z'/>%0A</g>%0A</svg>")
    repeat,
    linear-gradient(180deg, #FCF8F0 0%, #F5F0E6 45%, #EFE7D6 100%);
}

/* ===== 锦鲤背景层（z-index:0，主功能全部 z-index>=2，故在背后游动） ===== */
.koi-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

/* 单帧裁剪窗口：JS 只改这个节点的 transform，CSS 负责补间。
   容器保持水平只平移不 rotate —— 防止转向时大角度补间造成侧翻。
   但素材画布 224rpx×245rpx 是竖向的（v2 旧图），v3 舒展图是 252×140 横向，
   为兼容新素材改成 252rpx×140rpx */
.koi-clip {
  position: absolute;
  left: 0;
  top: 0;
  width: 252rpx;
  height: 140rpx;
  overflow: hidden;
  transition-property: transform;
  transition-timing-function: ease-in-out;
  will-change: transform;
}

/* 锦鲤本体：动画 WebP 自带摆动；
   方向表达全在这一层：scaleX(±1) 镜像翻转 + 固定小倾角摆头，
   过渡 0.3s 看起来像自然转身，不是翻滚 */
.koi-flip {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
  transform-origin: 50% 50%;
}

/* ===== 顶部导航栏（动态对齐胶囊） ===== */
.nav-bar {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 28rpx;
}

.nav-content {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.page-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
}

/* ===== 历史入口（标题下方左侧，圆角底图） ===== */
.history-entry {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 28rpx;
  margin-top: 8rpx;
  padding: 14rpx 28rpx 14rpx 18rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(201, 169, 97, 0.2);
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(120, 85, 50, 0.06);
  width: fit-content;
}

.history-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.history-text {
  font-size: 27rpx;
  color: #333;
}

/* ===== 签筒区域（钉在屏幕垂直正中心，不受顶/底元素影响，放大1.5倍） ===== */
.tube-area {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%) scale(1.5);
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.tube-area.shaking {
  animation: shakeTube 0.55s ease-in-out infinite;
}

@keyframes shakeTube {
  0%, 100% { transform: translateY(-50%) translateX(0) rotate(0deg) scale(1.5); }
  20% { transform: translateY(-50%) translateX(-6rpx) rotate(-2deg) scale(1.5); }
  40% { transform: translateY(-50%) translateX(6rpx) rotate(2deg) scale(1.5); }
  60% { transform: translateY(-50%) translateX(-4rpx) rotate(-1deg) scale(1.5); }
  80% { transform: translateY(-50%) translateX(4rpx) rotate(1deg) scale(1.5); }
}

/* 飞签 —— 与筒内签子样式一致（红头黄身） */
.flying-stick {
  position: absolute;
  width: 12rpx;
  height: 140rpx;
  background: linear-gradient(180deg, #C43028 0%, #C43028 18%, #E8D4A8 18%, #E8D4A8 100%);
  border-radius: 3rpx 3rpx 2rpx 2rpx;
  bottom: 45%;
  left: 50%;
  margin-left: -6rpx;
  opacity: 0;
  z-index: -1;
  transform-origin: bottom center;
  box-shadow: 2rpx 3rpx 8rpx rgba(120,70,30,0.25);
}

.flying-stick.fly {
  animation: flyOut 0.8s ease-out forwards;
}

@keyframes flyOut {
  0% { opacity: 1; transform: translateY(0) scale(0.75) rotate(12deg); }
  100% { opacity: 0; transform: translateY(-700rpx) scale(1.8) rotate(0deg); }
}

/* 签筒本体 —— 微收腰哑光朱砂红国风款 */
.tube-container {
  position: relative;
  width: 210rpx;
  height: 252rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  filter: drop-shadow(0 18rpx 22rpx rgba(120,70,30,0.16));
  z-index: 5;
}

/* 极淡暖光光晕 */
.tube-container::before {
  content: '';
  position: absolute;
  pointer-events: none;
  width: 360rpx;
  height: 360rpx;
  top: 46%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle,
    rgba(201,169,97,0.22) 0%,
    rgba(201,169,97,0.07) 42%,
    transparent 70%);
  z-index: -1;
  pointer-events: none;
}

/* 哑光金口沿 */
.tube-rim {
  width: 200rpx;
  height: 6rpx;
  background: linear-gradient(180deg, #A8893F 0%, #8a6d2f 100%);
  border-radius: 3rpx;
  position: relative;
  z-index: 3;
}

.tube-rim.top-rim {
  display: none;
}

/* 筒口 */
.tube-opening {
  width: 186rpx;
  height: 12rpx;
  background: transparent;
  position: relative;
  overflow: visible;
  z-index: 2;
}

.stick {
  position: absolute;
  bottom: -6rpx;
  transform-origin: bottom center;
  box-shadow: 1rpx 1rpx 3rpx rgba(80,40,20,0.25);
}

/* 筒身 */
.tube-body {
  width: 200rpx;
  height: 150rpx;
  background: linear-gradient(90deg,
    #8a1812 0%, #A8201A 24%, #B22A22 50%, #A8201A 76%, #8a1812 100%);
  clip-path: polygon(9% 0, 91% 0, 100% 100%, 0 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.tube-body::after {
  content: '';
  position: absolute;
  top: 0;
  left: 18%;
  width: 14%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255,235,210,0.08) 50%, transparent 100%);
}

/* 福字：篆书图片（透明底金色字，避免设备缺字体不显示） */
.tube-fu-img {
  width: 148rpx;
  height: 148rpx;
  margin-top: 3rpx;
  z-index: 3;
}

/* 底足金边 */
.bottom-rim {
  width: 206rpx;
  height: 10rpx;
  background: linear-gradient(180deg, #C9A961 0%, #A8893F 60%, #8a6d2f 100%);
  border-radius: 2rpx 2rpx 6rpx 6rpx;
  box-shadow: 0 2rpx 4rpx rgba(90,60,20,0.3);
  z-index: 3;
}

.tube-base {
  width: 196rpx;
  height: 6rpx;
  background: linear-gradient(180deg, rgba(120,70,30,0.25) 0%, transparent 100%);
  border-radius: 0 0 50% 50%;
  margin-top: 2rpx;
}

/* ===== 悬浮签 —— 米白竹木质感签牌 ===== */
.floating-sign {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  z-index: 500;
  opacity: 0;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
}

.floating-sign.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

.big-stick {
  width: 140rpx;
  height: 320rpx;
  background:
    linear-gradient(135deg,
      #F5F0E6 0%, #EDE5D5 25%,
      #F0EAD8 50%, #E8DFCC 75%,
      #EDE5D5 100%);
  border-radius: 18rpx;
  border: 2rpx solid rgba(180, 155, 120, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 6rpx 24rpx rgba(120, 85, 50, 0.18),
    0 2rpx 8rpx rgba(120, 85, 50, 0.12),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.6);
  position: relative;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
}

.big-stick::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 18rpx;
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 28rpx,
      rgba(180, 160, 130, 0.06) 28rpx,
      rgba(180, 160, 130, 0.06) 29rpx
    );
  pointer-events: none;
}

.sign-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.sign-char {
  color: #5C4A32;
  font-size: 30rpx;
  font-family: 'SourceHanSerifSC', 'STSong', 'SimSun', serif;
  font-weight: bold;
  line-height: 1.4;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

.sign-digit {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D2E1F;
  font-family: 'SourceHanSerifSC', 'STSong', 'SimSun', serif;
}

.sign-divider {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(160, 140, 110, 0.35) 20%,
    rgba(160, 140, 110, 0.5) 50%,
    rgba(160, 140, 110, 0.35) 80%,
    transparent 100%);
  margin: 14rpx 0 10rpx;
  border-radius: 1rpx;
}

.sign-level {
  color: #A8201A;
  font-size: 28rpx;
  font-weight: bold;
  font-family: 'SourceHanSerifSC', 'STSong', 'SimSun', serif;
  letter-spacing: 6rpx;
  text-shadow: 0 1rpx 2rpx rgba(168, 32, 26, 0.15);
}

/* ===== 开签撒花粒子层 ===== */
.confetti-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 600;
  pointer-events: none;
}

/* 数字逐位弹出（整体 spring 已由 .floating-sign 提供，这里补逐位 stagger） */
.floating-sign.show .sign-digit {
  display: inline-block;
  animation: digitPop 0.42s ease both;
}
@keyframes digitPop {
  0% { transform: translateY(12rpx) scale(0.4); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

/* 签等级发光一闪 */
.floating-sign.show .sign-level {
  animation: levelGlow 0.9s ease both;
}
@keyframes levelGlow {
  0%, 100% { text-shadow: 0 1rpx 2rpx rgba(168, 32, 26, 0.15); }
  45% { text-shadow: 0 0 14rpx rgba(255, 190, 90, 0.95); }
}

/* ===== 引流卡片区（公众号 + 个人微信，localMode=false 时显示，贴底） ===== */
.promo-section {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin: auto 28rpx 50rpx;   /* 最后一个值=距底间距；想上移就改大 */
  gap: 0;
}

.promo-card {
  flex: 1;
  flex-basis: 0;          /* 强制均分：忽略内容宽度差异 */
  min-width: 0;           /* 防止内容撑破 flex 均分 */
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(201, 169, 97, 0.25);
  border-radius: 20rpx;
  padding: 24rpx 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(120, 85, 50, 0.08);
}

.promo-header {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.promo-icon {
  font-size: 28rpx;
  line-height: 1;
}

.promo-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.promo-title {
  font-size: 24rpx;
  color: #5C4A32;
  font-weight: 600;
  letter-spacing: 0;
}

.promo-qrcode {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(180, 155, 120, 0.2);
  background: #fff;
}

.promo-hint {
  font-size: 20rpx;
  color: rgba(160, 140, 110, 0.6);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.promo-hint-sub {
  font-size: 18rpx;
  color: rgba(160, 140, 110, 0.45);
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
}

.promo-divider {
  width: 1rpx;
  background: linear-gradient(180deg,
    transparent 0%,
    rgba(201, 169, 97, 0.3) 30%,
    rgba(201, 169, 97, 0.3) 70%,
    transparent 100%);
  margin: 0 12rpx;
  align-self: stretch;
}

/* ===== 底部提示文字（localMode=true 时显示，贴底） ===== */
.bottom-tip {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 0 0 calc(50rpx + env(safe-area-inset-bottom));  /* 贴底；想上移就加大这个底部间距 */
  margin-top: auto;
}

.bottom-tip text {
  font-size: 22rpx;
  color: rgba(160, 140, 110, 0.5);
}
