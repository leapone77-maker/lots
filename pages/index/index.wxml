<view class="page">
  <!-- 顶部导航：标题（动态对齐胶囊） -->
  <view class="nav-bar" style="padding-top:{{navBarTop}}px">
    <view class="nav-content" style="height:{{navBarHeight}}px; line-height:{{navBarHeight}}px">
      <text class="page-title">阿鹏趣签</text>
    </view>
    <!-- 历史入口（紧贴标题下方） -->
    <view class="history-entry" bindtap="goHistory">
      <image class="history-icon" src="/images/jieqian-icon-peng.png" mode="aspectFit"/>
      <text class="history-text">历史</text>
    </view>
  </view>

  <!-- 签筒区域 -->
  <view class="tube-area {{isShaking ? 'shaking' : ''}}">
    <!-- 飞签动画 -->
    <view class="flying-stick {{isFlying ? 'fly' : ''}}" wx:if="{{isFlying || floatingSign}}"></view>

    <!-- 签筒本体（点击区限定为签筒资源大小） -->
    <view class="tube-container" bindtap="onDraw">
      <view class="tube-rim top-rim"></view>
      <view class="tube-opening">
        <view class="stick"
              wx:for="{{sticks}}"
              wx:key="index"
              style="left:{{item.x}}rpx; width:{{item.w}}rpx; height:{{item.h}}rpx; transform:rotate({{item.rot}}deg); background:{{item.bg}}; border-radius:{{item.br}};">
        </view>
      </view>
      <view class="tube-body">
        <image class="tube-fu-img" src="/images/jieqian-logo-peng.png" mode="aspectFit"/>
      </view>
      <view class="tube-rim bottom-rim"></view>
      <view class="tube-base"></view>
    </view>
  </view>

  <!-- 悬浮签（抽中后短暂停留） -->
  <view class="floating-sign {{floatingSign ? 'show' : ''}}" wx:if="{{floatingSign}}">
    <view class="big-stick">
      <view class="sign-vertical">
        <text class="sign-char">第</text>
        <block wx:for="{{drawnIdChars}}" wx:key="*this" wx:for-index="di">
          <text class="sign-char sign-digit" style="animation-delay:{{di * 0.08 + 0.12}}s">{{item}}</text>
        </block>
        <text class="sign-char">号</text>
      </view>
      <view class="sign-divider"></view>
      <text class="sign-level">{{drawnLevel}}</text>
    </view>
  </view>

  <!-- 开签撒花粒子层：仅在抽签动画期间渲染。canvas 是真机原生组件，
       常驻全屏会遮挡所有触摸事件（pointer-events 对原生组件无效），故按需挂载 -->
  <canvas wx:if="{{showConfetti}}" type="2d" id="confettiCanvas" class="confetti-canvas"></canvas>

  <!-- 引流卡片区（公众号 + 个人微信）：localMode=false 时显示 -->
  <view class="promo-section" wx:if="{{!localMode}}">
    <view class="promo-card">
      <view class="promo-header">
        <text class="promo-icon">📢</text>
        <view class="promo-title-wrap">
          <text class="promo-title">关注「阿鹏有礼」</text>
          <text class="promo-title">公众号</text>
        </view>
      </view>
      <image class="promo-qrcode" src="/images/qrcode-mp.jpg" mode="aspectFit" show-menu-by-longpress="{{true}}"/>
      <text class="promo-hint">长按识别二维码 → 关注公众号</text>
    </view>
    <view class="promo-divider"></view>
    <view class="promo-card">
      <view class="promo-header">
        <text class="promo-icon">📢</text>
        <view class="promo-title-wrap">
          <text class="promo-title">关注「阿鹏趣聚」</text>
          <text class="promo-title">公众号</text>
        </view>
      </view>
      <image class="promo-qrcode" src="/images/qrcode-qj.jpg" mode="aspectFit" show-menu-by-longpress="{{true}}"/>
      <text class="promo-hint">长按识别二维码 → 关注公众号</text>
    </view>
  </view>

  <!-- 底部提示：localMode=true 时显示 -->
  <view class="bottom-tip" wx:if="{{localMode}}">
    <text>本功能纯属娱乐，结果仅供参考</text>
  </view>

  <!-- 登录弹窗 -->
  <login-modal visible="{{showLogin}}" bind:close="onCloseLogin" bind:login="onLogin"/>
</view>
