page {
  background: #F5F0E6;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    url("data:image/svg+xml,<svg%20xmlns='http://www.w3.org/2000/svg'%20width='90'%20height='90'%20viewBox='0%200%2090%2090'>%0A<g%20fill='%23C9A961'%20fill-opacity='0.06'>%0A<path%20d='M22%2058c0-9%207-15%2015-14%203-9%2015-9%2018-1%208-3%2015%205%2012%2012-3%208-13%207-18%204-4%206-15%205-19-1-5%203-12-1-14-6z'/>%0A<path%20d='M52%2030c0-6%205-10%2011-9%202-6%2011-6%2013%200%206-2%2011%204%209%209-2%206-10%205-14%203-3%204-11%203-14-1-3%202-8-1-10-5z'/>%0A</g>%0A</svg>")
    repeat,
    linear-gradient(180deg, #FCF8F0 0%, #F5F0E6 45%, #EFE7D6 100%);
}

.main-scroll {
  flex: 1;
  height: 0;
}

/* 状态容器（加载/过期/未找到） */
.status-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.status-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(168,32,26,0.2);
  border-top-color: #A8201A;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-text {
  font-size: 28rpx;
  color: #666;
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.6;
}

.action-btn {
  width: 320rpx;
  height: 80rpx;
  background: #A8201A;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

/* 内容容器 */
.content-container {
  padding: 24rpx;
}

/* 签文卡片 */
.qian-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: rgba(255,253,248,0.9);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(120,85,50,0.08);
}

.qian-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.qian-badge {
  padding: 6rpx 18rpx;
  background: #A8201A;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
}

.qian-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.qian-poem-section {
  margin-bottom: 20rpx;
}

.poem-label {
  display: block;
  font-size: 24rpx;
  color: #A8201A;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.poem-text {
  display: block;
  font-size: 29rpx;
  color: #333;
  line-height: 1.75;
  letter-spacing: 1rpx;
  font-family: 'Source Han Serif SC', serif;
}

.card-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201,169,97,0.3), transparent);
  margin: 20rpx 0;
}

.interpret-section {
  margin-bottom: 12rpx;
}

.interp-label {
  display: block;
  font-size: 24rpx;
  color: #A8201A;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.basic-text {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

.yiji-section {
  margin-top: 16rpx;
}

.yiji-label {
  display: block;
  font-size: 24rpx;
  color: #A8201A;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.yiji-text {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

/* 聊天区域 */
.chat-section {
  padding: 24rpx;
  background: rgba(255,253,248,0.6);
  border-radius: 20rpx;
}

.chat-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(201,169,97,0.2);
}

.chat-title {
  font-size: 26rpx;
  color: #A8201A;
  font-weight: bold;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message {
  display: flex;
  align-items: flex-start;
}

.message.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(168,32,26,0.08);
  border: 1rpx solid rgba(168,32,26,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0 12rpx;
  overflow: hidden;
}

.avatar-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
}

.message-avatar text {
  font-size: 24rpx;
  color: #A8201A;
}

.message-bubble {
  max-width: 70%;
  background: rgba(255,255,255,0.8);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(120,90,50,0.06);
}

.message.user .message-bubble {
  background: rgba(201,169,97,0.2);
}

.message.user .message-bubble rich-text {
  color: #4a3728;
}

.message-bubble rich-text {
  color: #333;
  font-size: 26rpx;
  line-height: 1.6;
}
